# Copy this file to .env and fill in the values you need.
# Every one of these maps directly to a field in src/repograte/config.py.

# --- LLMs ---
ANTHROPIC_API_KEY=
# Must be a real model id - see https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Sandbox (E2B) ---
E2B_API_KEY=
E2B_TEMPLATE=base
E2B_TIMEOUT_SECONDS=300
# Override for non-TypeScript projects (or use --install-cmd/--test-cmd per run).
SANDBOX_INSTALL_CMD=npm install --no-audit --no-fund
SANDBOX_TEST_CMD=npx tsc --noEmit

# --- VCS ---
# Needs "repo" scope; required to push a branch and open a PR.
GITHUB_TOKEN=

# --- Vector store (optional; only used if you want persistent/shared retrieval) ---
# Leave both blank to use a throwaway in-memory Qdrant instance instead.
QDRANT_URL=
QDRANT_API_KEY=
ENABLE_RAG_CONTEXT=true
RAG_MAX_FILES=40

# --- Orchestration ---
MAX_CORRECTION_LOOPS=4
# Set to an empty string to use a pure in-memory checkpointer instead
# (loses all state when the process exits; not recommended).
CHECKPOINT_PATH=.repograte/checkpoints.sqlite
